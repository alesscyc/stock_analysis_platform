{
  "name": "stock-platform-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop shell for the Stock Analysis Platform (Electron + Express + FastAPI).",
  "author": "Stock Analysis Platform",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node build.js",
    "dist:installer": "electron-builder --win nsis",
    "test": "node --test test/desktop.test.js"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.stockanalysis.platform",
    "productName": "Stock Analysis Platform",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "desktop-paths.js"
    ],
    "extraResources": [
      { "from": "resources", "to": "" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}